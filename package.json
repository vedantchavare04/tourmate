{
  "name": "tourmate",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@prisma/config": "7.9.1",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "prettier": "^3.7.4",
    "prisma": "^7.9.1",
    "turbo": "2.10.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.7"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/driver-adapter-utils": "7.9.1",
    "@tourmate/db": "workspace:*",
    "pg": "^8.23.0"
  }
}
